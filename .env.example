# WhatsAPI Configuration
PORT=3000

# Web GUI Login (Username otomatis: admin)
# Password akan otomatis di-hash secara aman menggunakan algoritma scrypt
ADMIN_PASSWORD=ganti_dengan_password_admin_rahasia

# API Key untuk integrasi sistem/aplikasi eksternal (POST /send)
# (Opsional - jika dikosongkan akan di-generate otomatis oleh server)
API_KEY=ganti_dengan_api_key_rahasia_anda

# Webhook URL (Opsional - meneruskan pesan masuk ke backend/sistem luar)
# Bisa juga diatur langsung lewat Web Dashboard
WEBHOOK_URL=https://webhook.site/ganti_dengan_url_anda
